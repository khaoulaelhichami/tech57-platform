{
  "info": {
    "name": "Tech57 Platform API",
    "description": "Collection Postman pour tester l'API Tech57 Platform\n\nAuthentification: La plupart des endpoints nécessitent un token JWT.\n1. Appelez d'abord POST /api/auth/login\n2. Copiez le token reçu\n3. Dans Postman, définissez la variable globale \"token\"\n4. Les requêtes admin utiliseront automatiquement le header Authorization: Bearer {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('token', jsonData.token);",
                  "  console.log('Token saved:', jsonData.token);",
                  "}",
                  "",
                  "pm.test('Login successful', function() {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(jsonData).to.have.property('token');",
                  "  pm.expect(jsonData).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tech57.com\",\n  \"motDePasse\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authentification administrateur.\nRetourne un token JWT à utiliser pour les endpoints protégés."
          }
        }
      ]
    },
    {
      "name": "2. Endpoints Publics (aucun token requis)",
      "item": [
        {
          "name": "GET Services",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/public/services", "host": ["{{base_url}}"], "path": ["public", "services"] },
            "description": "Liste des services actifs (vitrine publique)"
          }
        },
        {
          "name": "GET Projets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/public/projets", "host": ["{{base_url}}"], "path": ["public", "projets"] },
            "description": "Liste des projets actifs"
          }
        },
        {
          "name": "GET Clients",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/public/clients", "host": ["{{base_url}}"], "path": ["public", "clients"] },
            "description": "Liste des clients actifs"
          }
        },
        {
          "name": "GET Partenaires",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/public/partenaires", "host": ["{{base_url}}"], "path": ["public", "partenaires"] },
            "description": "Liste des partenaires actifs"
          }
        },
        {
          "name": "GET Membres",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/public/membres", "host": ["{{base_url}}"], "path": ["public", "membres"] },
            "description": "Liste des membres de l'équipe actifs"
          }
        },
        {
          "name": "GET Pièces requises",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/demandes/pieces-requises", "host": ["{{base_url}}"], "path": ["demandes", "pieces-requises"] },
            "description": "Liste des pièces requises pour une demande de stage"
          }
        },
        {
          "name": "POST Postuler (Demande de stage)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "donnees", "value": "{\n  \"nom\": \"Dupont\",\n  \"prenom\": \"Jean\",\n  \"email\": \"jean.dupont@email.com\",\n  \"telephone\": \"0612345678\",\n  \"etablissement\": \"ENSA\",\n  \"domaine\": \"Informatique\",\n  \"periodeDebut\": \"2026-09-01\",\n  \"periodeFin\": \"2026-12-31\"\n}", "type": "text", "contentType": "application/json" },
                { "key": "cv", "type": "file", "src": "", "description": "Fichier CV (optionnel)" },
                { "key": "cin", "type": "file", "src": "" },
                { "key": "lettreMotivation", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{base_url}}/demandes/postuler", "host": ["{{base_url}}"], "path": ["demandes", "postuler"] },
            "description": "Soumettre une demande de stage (multipart/form-data).\nLe champ 'donnees' est un JSON avec les informations du candidat.\nLes fichiers sont optionnels."
          }
        }
      ]
    },
    {
      "name": "3. Endpoints Admin (token requis)",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/admin/dashboard/stats", "host": ["{{base_url}}"], "path": ["admin", "dashboard", "stats"] },
            "description": "Statistiques du tableau de bord"
          }
        },
        {
          "name": "Demandes - Liste",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/admin/demandes",
              "host": ["{{base_url}}"],
              "path": ["admin", "demandes"],
              "query": [
                { "key": "statut", "value": "RECUE", "disabled": true, "description": "Filtrer par statut: RECUE, EN_COURS_ETUDE, ACCEPTEE, REFUSEE, etc." }
              ]
            },
            "description": "Liste de toutes les demandes de stage (filtre optionnel par statut)"
          }
        },
        {
          "name": "Demandes - Détail par ID",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/admin/demandes/1", "host": ["{{base_url}}"], "path": ["admin", "demandes", "1"] },
            "description": "Détail d'une demande de stage (remplacer 1 par l'ID réel)"
          }
        },
        {
          "name": "Demandes - Changer statut",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/admin/demandes/1/statut?statut=ACCEPTEE",
              "host": ["{{base_url}}"],
              "path": ["admin", "demandes", "1", "statut"],
              "query": [ { "key": "statut", "value": "ACCEPTEE" } ]
            },
            "description": "Changer le statut d'une demande.\nValeurs possibles: RECUE, EN_COURS_ETUDE, ACCEPTEE, REFUSEE, EN_ATTENTE_COMPLEMENT, STAGE_EN_COURS, STAGE_TERMINE"
          }
        },
        {
          "name": "Demandes - Ajouter note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": {
              "mode": "raw",
              "raw": "Candidat très motivé, dossier complet."
            },
            "url": { "raw": "{{base_url}}/admin/demandes/1/note", "host": ["{{base_url}}"], "path": ["admin", "demandes", "1", "note"] },
            "description": "Ajouter/modifier la note admin (body en texte brut, pas JSON)"
          }
        },
        {
          "name": "Demandes - Documents",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/admin/demandes/1/documents", "host": ["{{base_url}}"], "path": ["admin", "demandes", "1", "documents"] },
            "description": "Liste des documents d'une demande"
          }
        },
        {
          "name": "Demandes - Télécharger document",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/admin/documents/1/telecharger", "host": ["{{base_url}}"], "path": ["admin", "documents", "1", "telecharger"] },
            "description": "Télécharger un fichier par ID de document"
          }
        },
        {
          "name": "Demandes - Export PDF",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/admin/demandes/1/export-pdf", "host": ["{{base_url}}"], "path": ["admin", "demandes", "1", "export-pdf"] },
            "description": "Exporter une demande en PDF"
          }
        },
        {
          "name": "Demandes - Export Excel",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/admin/demandes/export-excel",
              "host": ["{{base_url}}"],
              "path": ["admin", "demandes", "export-excel"],
              "query": [ { "key": "statut", "value": "RECUE", "disabled": true } ]
            },
            "description": "Exporter toutes les demandes en Excel (filtre optionnel par statut)"
          }
        }
      ]
    },
